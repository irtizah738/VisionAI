# Gemini API Key (server-side only via @google/genai)
GEMINI_API_KEY=""

# Container Application URL for OAuth Redirects & Webhooks
APP_URL="http://localhost:3000"

# PostgreSQL Database URL (optional; uses persistent local store and Firebase Firestore if omitted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visionai"

# NextAuth Configuration
NEXTAUTH_SECRET="visionai-studio-secret"
NEXTAUTH_URL="http://localhost:3000"

# 3P Social Network OAuth 2.0 Credentials (Optional - enables direct live OAuth provider popups)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Billing & Webhook Credentials
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# HubSpot CRM Integration & Webhook Credentials
HUBSPOT_ACCESS_TOKEN=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_WEBHOOK_SECRET=""

# Domain & SSL Health Configuration
CUSTOM_DOMAIN="visionai.studio"
